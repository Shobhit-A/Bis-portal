DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bis_portal"
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="7d"
PORT=5000
CLIENT_URL="http://localhost:5173"
BREVO_API_KEY="your-brevo-api-key"
ADMIN_EMAIL="it01@absoluteveritas.com"
MAX_FILE_SIZE_MB=5
NODE_ENV="development"

# Cloudflare R2 (S3-compatible object storage for uploaded documents)
# Dashboard: R2 > Manage API Tokens > Create API Token (Object Read & Write)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="bis-portal-documents"
